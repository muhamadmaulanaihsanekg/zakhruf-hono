{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zakhruf-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zakhruf-db",
      "database_id": "local-zakhruf-db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "zakhruf-storage"
    }
  ]
}
